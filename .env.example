# Frontend env vars (Vite). Copy to `.env.local` for local development.
# `.env.local` is gitignored — never commit real values.
#
# The AI mode needs to know WHERE the proxy lives. Pick ONE of the two options.

# ---------------------------------------------------------------------------
# OPTION A (easiest) — use the already-deployed Render proxy.
# No API key needed locally: the key lives on Render. The deployed server
# already allows http://localhost:5173 via CORS.
# ---------------------------------------------------------------------------
VITE_AI_PROXY_URL=https://grigliepromo.onrender.com

# ---------------------------------------------------------------------------
# OPTION B — run the proxy yourself on localhost.
#   1. cp server/.env.example server/.env  and put your ANTHROPIC_API_KEY in it
#   2. cd server && npm install && npm start     (listens on :8787)
#   3. comment out OPTION A above and uncomment the line below
# ---------------------------------------------------------------------------
# VITE_AI_PROXY_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# OPTION C — same-origin (this is what Render itself uses in production, set
# via render.yaml). Only useful if you serve the built app from the proxy:
#   npm run build && node server/index.js
# ---------------------------------------------------------------------------
# VITE_AI_SAME_ORIGIN=1
