# Copy this file to server/.env and fill in your key. NEVER commit server/.env.
# Get a key at https://console.anthropic.com/ (rotate it if it ever leaks).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=8787
# Comma-separated list of allowed browser origins (CORS).
# Include your GitHub Pages origin and your local dev origin.
ALLOWED_ORIGINS=http://localhost:5173,https://alexveneselli2.github.io
# Model to use (defaults to claude-opus-4-8)
AI_MODEL=claude-opus-4-8
